# Copy to .env.local (gitignored) and fill in once you have a real Firebase
# project — see docs/CLOUD_AUTH_SETUP.md. Without this file, the app runs
# against the local Firebase Emulator Suite automatically (npm run dev, in
# a second terminal: npm run firebase:emulators) — no real project needed
# for local development.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to force a real Firebase config above to still talk to a
# locally running emulator suite instead of production (rarely needed).
VITE_USE_FIREBASE_EMULATOR=false

# Which social sign-in buttons to offer, comma-separated: google, apple,
# facebook. Leave unset for all three (the local emulator stubs all of them).
# Only list providers you have actually enabled in the Firebase console —
# Sign in with Apple needs a paid Apple Developer membership, so a build
# without one should use "google,facebook". Set to "none" for email only.
# VITE_AUTH_PROVIDERS=google,facebook
