# INKWELL's Firebase project — the address every build signs in to.
#
# These values are deliberately public: a Firebase web config is an address,
# not a secret. What protects the data is the Firestore security rules
# deployed on the project (each user can reach only their own library) —
# never the obscurity of these strings. See docs/CLOUD_AUTH_SETUP.md.
VITE_FIREBASE_API_KEY=AIzaSyAxgU61koa2rA-N3XoJTBXjtZBRXb-pB8g
VITE_FIREBASE_AUTH_DOMAIN=inkwell-4c7eb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inkwell-4c7eb
VITE_FIREBASE_STORAGE_BUCKET=inkwell-4c7eb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=564384231604
VITE_FIREBASE_APP_ID=1:564384231604:web:bfd7bac65b738d11bb27e1

# Google sign-in only, plus email/password (always on). Apple costs money
# and Facebook was never registered — a button that can only fail is worse
# than no button.
VITE_AUTH_PROVIDERS=google
